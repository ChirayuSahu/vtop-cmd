{
  // The extension's TypeScript sources live in src/ and compile one-to-one into plain browser
  // scripts in build/ (no bundling); scripts/build.py packages them with static/ and vendor/.
  // build/ is git-ignored; run `npm run compile` (build and test do it for you).
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Files without import/export stay classic scripts that share globals, as content scripts do.
    "moduleDetection": "auto",
    "rootDir": "src",
    "outDir": "build",
    "types": ["chrome"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "newLine": "lf"
  },
  "include": ["src"]
}
