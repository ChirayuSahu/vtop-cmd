{
  "manifest_version": 3,
  "name": "VTOP Command",
  "version": "1.2.3",
  "description": "Unofficial helper for VIT's VTOP: ⌘K command menu, dark mode, attendance and marks totals, a CGPA calculator and a document viewer.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://vtop.vit.ac.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vtop.vit.ac.in/vtop/*"
      ],
      "js": [
        "brand.js",
        "combobox.js",
        "search-select.js",
        "form-presets.js",
        "navigation.js",
        "semesters.js",
        "enhancements.js",
        "page-actions.js",
        "cgpa.js",
        "content.js",
        "dark-readability.js",
        "cgpa-ui.js",
        "deadline-cache-client.js",
        "page-enhancements.js",
        "pdf-preview.js",
        "captcha-solver.js",
        "captcha.js"
      ],
      "css": [
        "dark.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vtop.vit.ac.in/vtop/*"
      ],
      "js": [
        "page-runtime.js",
        "pdf-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf-viewer.html",
        "pdf-viewer.css",
        "pdf-viewer.mjs",
        "pptx-viewer.mjs",
        "ppt-viewer.mjs",
        "word-viewer.mjs",
        "brand.js",
        "vendor/pdf.mjs",
        "vendor/pdf.worker.mjs",
        "vendor/cmaps/*",
        "vendor/standard_fonts/*",
        "vendor/pptx-renderer.browser.mjs",
        "vendor/pptjs/pptjs.mjs",
        "vendor/docx/*.mjs",
        "vendor/msdoc/*",
        "vendor/msdoc/modules/core/*",
        "vendor/msdoc/modules/msdoc/*",
        "vendor/msdoc/modules/render/*",
        "captcha-model.json"
      ],
      "matches": [
        "https://vtop.vit.ac.in/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "VTOP Command",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "navigation.js",
      "command-history.js",
      "deadline-cache.js",
      "extension-action.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{da7a1fc0-9e4b-49e7-9e37-bb4fb5c02cd1}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data:; font-src 'self' blob: data:; connect-src 'self' blob: data:; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none';"
  }
}
