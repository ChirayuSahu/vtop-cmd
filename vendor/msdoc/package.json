{
  "name": "@file-viewer/doc",
  "version": "3.3.3",
  "private": false,
  "type": "module",
  "description": "Browser-native legacy MS-DOC (.doc) parser and HTML renderer extracted from the public msdoc-viewer 0.2.0 line.",
  "keywords": [
    "file-viewer",
    "doc",
    "ms-doc",
    "ole",
    "cfb",
    "word",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted",
    "offline-first"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git"
  },
  "homepage": "https://github.com/flyfish-dev/docjs",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/core/binary.d.ts",
    "dist/core/binary.js",
    "dist/core/cfb.d.ts",
    "dist/core/cfb.js",
    "dist/core/inflate.d.ts",
    "dist/core/inflate.js",
    "dist/core/utils.d.ts",
    "dist/core/utils.js",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/msdoc/clx.d.ts",
    "dist/msdoc/clx.js",
    "dist/msdoc/constants.d.ts",
    "dist/msdoc/constants.js",
    "dist/msdoc/fib.d.ts",
    "dist/msdoc/fib.js",
    "dist/msdoc/fkp.d.ts",
    "dist/msdoc/fkp.js",
    "dist/msdoc/fonts.d.ts",
    "dist/msdoc/fonts.js",
    "dist/msdoc/html-word.d.ts",
    "dist/msdoc/html-word.js",
    "dist/msdoc/objects.d.ts",
    "dist/msdoc/objects.js",
    "dist/msdoc/officeart.d.ts",
    "dist/msdoc/officeart.js",
    "dist/msdoc/parser.d.ts",
    "dist/msdoc/parser.js",
    "dist/msdoc/properties.d.ts",
    "dist/msdoc/properties.js",
    "dist/msdoc/sprm.d.ts",
    "dist/msdoc/sprm.js",
    "dist/msdoc/styles.d.ts",
    "dist/msdoc/styles.js",
    "dist/msdoc/vector.d.ts",
    "dist/msdoc/vector.js",
    "dist/render/fonts.d.ts",
    "dist/render/fonts.js",
    "dist/render/html.d.ts",
    "dist/render/html.js",
    "dist/types.d.ts",
    "dist/types.js",
    "dist/viewer.d.ts",
    "dist/viewer.js",
    "dist/worker-client.d.ts",
    "dist/worker-client.js",
    "dist/worker.d.ts",
    "dist/worker.js",
    "LICENSE",
    "README.en.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "dompurify": "3.4.17"
  },
  "license": "MIT",
  "fileViewer": {
    "distribution": {
      "schemaVersion": 1,
      "mode": "runtime-only"
    }
  }
}
