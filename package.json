{
  "name": "vtop-command-menu",
  "version": "1.2.4",
  "private": true,
  "license": "MIT",
  "description": "A local, DOM-driven command menu for VTOP",
  "scripts": {
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test",
    "check": "tsc -p . --noEmit && node --check scripts/build.cjs",
